# BLE provisioning needs Bluetooth. NimBLE is used rather than Bluedroid
# because it is markedly smaller, which matters on a 4 MB ESP32.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# The app plus a BLE stack does not fit the default single-app layout.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Wi-Fi credentials are stored by the provisioning manager.
CONFIG_NETWORK_PROV_WIFI_STA_ALL_CHANNEL_SCAN=y

# BoardMaster's "Set up a new board" speaks protocomm security 1 (X25519 +
# proof of possession + AES-CTR). ESP-IDF 6 turns it off by default in favour
# of security 2 (SRP6a + AES-GCM), so switch it back on.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
